# Cible Bedrock (boto3 / bedrock-runtime). Utilisation :
#   cp .env.example.bedrock .env.bedrock   puis   uv run python -m mmprobe --env-file .env.bedrock bedrock-models
#   uv run python -m mmprobe --env-file .env.bedrock run
MM_PROVIDER=bedrock
MM_AWS_REGION=eu-west-3        # région des modèles (aussi AWS_REGION / AWS_DEFAULT_REGION)
# Identifiants : chaîne standard boto3 (AWS_PROFILE, AWS_ACCESS_KEY_ID/…, SSO, rôle) ou clé API Bedrock.
# MM_AWS_PROFILE=mon-profil
# AWS_BEARER_TOKEN_BEDROCK=...  # clé API Bedrock (OK pour Converse/InvokeModel)
# MM_LABEL=bedrock-eu-west-3    # dossier de captures (défaut: bedrock-<région>)
# MM_TIMEOUT=180
# Proxy / TLS d'entreprise : HTTPS_PROXY, NO_PROXY et AWS_CA_BUNDLE=/chemin/ca-bundle.pem sont lus par boto3.

# Rôles de modèles : AUCUN défaut volontaire (ids et inference profiles dépendent de la région/du compte).
# `bedrock-models` liste ce qui est disponible ; pour un modèle servi par inference profile, mettre l'id du profil (ex. eu.anthropic.…).
# MM_BEDROCK_MODEL_VISION=            # modèle vision principal (cas image ; InvokeModel natif si id Anthropic)
# MM_BEDROCK_MODEL_VISION_NOVA=       # un Nova avec image (cas InvokeModel natif Nova)
# MM_BEDROCK_MODEL_VISION_OTHER=      # une 3e famille (Llama 4, Pixtral, Qwen3-VL, Gemma…)
# MM_BEDROCK_MODEL_AUDIO_IN=          # modèle à modalité SPEECH en Converse, ex. mistral.voxtral-small-24b-2507
# MM_BEDROCK_MODEL_AUDIO_IN_MINI=     # ex. mistral.voxtral-mini-3b-2507
# MM_BEDROCK_MODEL_TEXT_ONLY=         # modèle sans image ni audio (cas négatifs), ex. amazon.nova-micro-v1:0
# MM_BEDROCK_MODEL_SONIC=             # amazon.nova-2-sonic-v1:0 (pour constater qu'il n'est pas joignable par Converse/InvokeModel)

# URL d'image publique (cas invoke_claude_native_url)
# MM_IMAGE_URL=https://www.python.org/static/community_logos/python-logo.png
