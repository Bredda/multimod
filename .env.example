# Copier vers .env (ou .env.<cible>) puis : uv run python -m mmprobe --env-file .env.<cible> run
MM_BASE_URL=https://api.openai.com/v1
MM_API_KEY=sk-...
# Nom du dossier de captures (défaut : dérivé du host). Sert à comparer plusieurs cibles.
# MM_LABEL=openai

# Headers additionnels (JSON), p.ex. pour une gateway : {"X-Team":"multimod"}
# MM_EXTRA_HEADERS={}
# MM_TIMEOUT=180
# MM_VERIFY_TLS=true

# Paramètre de limite de tokens à utiliser dans /chat/completions
# (OpenAI récent : max_completion_tokens ; LiteLLM/anciens : max_tokens)
# MM_MAX_TOKENS_PARAM=max_completion_tokens

# Alias de modèles par rôle (adapter aux noms exposés par la cible)
# MM_MODEL_TTS=gpt-4o-mini-tts
# MM_MODEL_TTS_LEGACY=tts-1
# MM_MODEL_STT=gpt-4o-transcribe
# MM_MODEL_STT_MINI=gpt-4o-mini-transcribe
# MM_MODEL_STT_WHISPER=whisper-1
# MM_MODEL_STT_DIARIZE=gpt-4o-transcribe-diarize
# MM_MODEL_VISION=gpt-4o-mini
# MM_MODEL_TEXT_ONLY=gpt-3.5-turbo     # modèle SANS vision/audio, pour les cas négatifs
# MM_MODEL_AUDIO_CHAT=gpt-audio   # gpt-4o-audio-preview n'existe plus côté OpenAI ; aussi gpt-audio-mini

# URL d'image publique pour le cas "image par URL"
# MM_IMAGE_URL=https://www.python.org/static/community_logos/python-logo.png
