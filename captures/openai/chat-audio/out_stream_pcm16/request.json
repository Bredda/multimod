{
  "method": "POST",
  "url": "https://api.openai.com/v1/chat/completions",
  "headers": {
    "Authorization": "Bearer sk-…<redacted>",
    "Content-Type": "application/json"
  },
  "body": {
    "model": "gpt-audio",
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "Say hello in one short sentence."
          }
        ]
      }
    ],
    "max_completion_tokens": 300,
    "stream": true,
    "stream_options": {
      "include_usage": true
    },
    "modalities": [
      "text",
      "audio"
    ],
    "audio": {
      "voice": "alloy",
      "format": "pcm16"
    }
  }
}