{
  "method": "POST",
  "url": "https://api.openai.com/v1/chat/completions",
  "headers": {
    "Authorization": "Bearer sk-…<redacted>",
    "Content-Type": "application/json"
  },
  "body": {
    "model": "gpt-4o-mini",
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "List the shapes and their colors."
          },
          {
            "type": "image_url",
            "image_url": {
              "url": "data:image/png;base64,<2944 chars, sha256:5fe61d71146d>"
            }
          }
        ]
      }
